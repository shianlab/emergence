{
  "name": "emergence-tui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "vendor/meta-kim",
    "LICENSE",
    "vendor/upstream-notices"
  ],
  "bin": {
    "emergence": "bin/emergence.cjs"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "models:ui": "tsx scripts/dev.ts model-config",
    "test:model-config": "tsx --test tests/model-configuration.test.ts",
    "test:model-config:runtime": "tsx tests/model-config-runtime.ts",
    "test:model-config:native": "tsx tests/model-config-native.ts",
    "inspect:model-config": "tsx tests/model-config-runtime.ts --audit",
    "test:model-config:live": "tsx tests/model-config-live.ts --live",
    "build": "tsx scripts/build.ts",
    "start": "node bin/emergence.cjs",
    "dev": "tsx scripts/dev.ts",
    "test:e2e": "node --import tsx tests/phase2-e2e.ts",
    "test:terminal": "node --import tsx tests/phase2-terminal.ts",
    "test:workspace": "node --import tsx tests/phase3-terminal.ts",
    "test:tui-home": "node --experimental-ffi --import tsx tests/tui-phase1.ts",
    "test:tui-home:terminal": "node --import tsx tests/tui-phase1-terminal.ts",
    "test:tui-messages": "node --experimental-ffi --import tsx tests/tui-phase2.ts",
    "test:tui-messages:terminal": "node --import tsx tests/tui-phase2-terminal.ts",
    "test:tui-composer": "node --experimental-ffi --import tsx tests/tui-phase3.ts",
    "test:tui-composer:terminal": "node --import tsx tests/tui-phase3-terminal.ts",
    "test:core-interaction": "node --experimental-ffi --import tsx tests/tui-core-phase1.ts",
    "test:core-planning": "tsx --test tests/core-planning.test.ts",
    "test:core-foundation": "tsx --test tests/core-foundation.test.ts",
    "test:tui-workspace": "node --experimental-ffi --import tsx tests/tui-phase4.ts",
    "test:tui-aggregate": "node --experimental-ffi --import tsx tests/tui-aggregate.ts",
    "test:tui-workspace:terminal": "node --import tsx tests/tui-phase4-terminal.ts",
    "probe:harness": "tsx probes/harness.ts",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "inspect": "tsx scripts/inspect-full.ts",
    "inspect:local": "tsx scripts/inspect-full.ts",
    "release:prepare": "tsx scripts/release-prepare.ts",
    "release:pack": "tsx scripts/release-pack.ts",
    "test:release": "tsx tests/phase6-release.ts",
    "test:stability": "node --experimental-ffi --expose-gc --import tsx tests/phase6-stability.ts",
    "test:personalization": "node --import tsx tests/phase5-terminal.ts",
    "inspect:security": "tsx scripts/inspect-security.ts",
    "inspect:full": "tsx scripts/inspect-full.ts",
    "test:core-execution": "tsx --test tests/core-execution.test.ts",
    "test:master-dispatch": "tsx --test tests/master-dispatch.test.ts",
    "test:master-followthrough": "tsx --test tests/master-followthrough.test.ts",
    "test:master-feedback": "node --experimental-ffi --import tsx tests/tui-master-phase4.ts",
    "test:approvals": "tsx --test tests/workspace-approvals.test.ts tests/interactions.test.ts",
    "test:approvals:tui": "node --experimental-ffi --import tsx tests/tui-approvals-r3.ts",
    "test:recovery": "tsx --test tests/request-recovery.test.ts tests/task-failures.test.ts tests/core-execution.test.ts tests/master-followthrough.test.ts tests/scheduler-budgets.test.ts",
    "test:recovery:http": "tsx tests/request-recovery-http.ts",
    "test:core-live": "tsx tests/core-live.ts --live",
    "test:core-memory": "tsx --test tests/core-memory.test.ts tests/core-assurance.test.ts",
    "check:style": "tsx scripts/check-orchestration.ts",
    "format:orchestration": "tsx scripts/check-orchestration.ts --write",
    "check": "npm run typecheck && npm run check:style && npm run check:architecture",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "format": "tsx scripts/check-orchestration.ts --write",
    "test:independent-windows": "tsx --test tests/independent-windows.test.ts",
    "test:independent-windows:tui": "node --experimental-ffi --import tsx tests/tui-independent-windows.ts",
    "historical:test:collaboration": "node --import tsx tests/phase4-terminal.ts",
    "historical:inspect:runtime": "tsx scripts/inspect-runtime-team.ts",
    "historical:test:runtime-live": "tsx tests/runtime-live.ts --live",
    "historical:test:kim-live": "tsx tests/kim-team-live.ts --live",
    "historical:test:master-followthrough:live": "tsx tests/master-followthrough-live.ts --live",
    "historical:test:master-team:live": "tsx tests/master-team-live.ts --live",
    "historical:test:master-live": "tsx tests/master-dispatch-live.ts --live",
    "historical:inspect:master3": "tsx scripts/inspect-master-phase3.ts",
    "historical:inspect:master4": "tsx scripts/inspect-master-phase4.ts",
    "historical:inspect:e4": "tsx scripts/inspect-experience-e4.ts",
    "historical:inspect:audit": "tsx scripts/inspect-audit.ts",
    "historical:inspect:backend": "tsx scripts/inspect-backend.ts",
    "historical:inspect:release": "tsx scripts/inspect-phase6.ts --release",
    "historical:inspect:phase2": "tsx scripts/inspect-phase2.ts",
    "historical:inspect:phase3": "tsx scripts/inspect-phase3.ts",
    "historical:inspect:phase4": "tsx scripts/inspect-phase4.ts",
    "historical:inspect:phase5": "tsx scripts/inspect-phase5.ts",
    "historical:inspect:e1": "tsx scripts/inspect-experience-e1.ts",
    "historical:inspect:e2": "tsx scripts/inspect-experience-e2.ts",
    "historical:inspect:e3": "tsx scripts/inspect-experience-e3.ts",
    "historical:inspect:e5": "tsx scripts/inspect-experience-e5.ts",
    "historical:inspect:core1": "tsx scripts/inspect-core-phase1.ts",
    "historical:inspect:core2": "tsx scripts/inspect-core-phase2.ts",
    "historical:inspect:core3": "tsx scripts/inspect-core-phase3.ts",
    "historical:inspect:core4": "tsx scripts/inspect-core-phase4.ts",
    "historical:inspect:core5": "tsx scripts/inspect-core-phase5.ts",
    "historical:inspect:core6": "tsx scripts/inspect-core-phase6.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-cmdline": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.2-alpha.2",
    "@opentui/core": "0.7.0",
    "js-yaml": "4.3.2",
    "marked": "17.0.1",
    "string-width": "8.1.1",
    "typescript": "5.9.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@xterm/headless": "5.5.0",
    "esbuild": "0.25.12",
    "node": "26.13.0",
    "node-pty": "1.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15"
  },
  "overrides": {
    "zod": "$zod",
    "@modelcontextprotocol/client": "2.3.0",
    "fflate": "0.8.3",
    "undici": "8.12.2"
  },
  "description": "An independent terminal agent for coding and data analysis.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shianlab/emergence.git",
    "directory": "emergence"
  },
  "homepage": "https://github.com/shianlab/emergence#readme",
  "bugs": {
    "url": "https://github.com/shianlab/emergence/issues"
  }
}
